{
  "name": "durable-thinking",
  "version": "3.1.0",
  "description": "Persistent Sequential Thinking MCP 2026-07-28 server with per-thought MCP App cards, on Cloudflare Workers and Durable Objects",
  "private": true,
  "repository": "github:linxule/durable-thinking",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "check:app": "node scripts/check-mcp-app.mjs",
    "check": "npm run check:app && npm run check:contract && npm run typecheck && npm run test",
    "verify": "npm run check && npm run build",
    "secrets": "node scripts/generate-secrets.mjs",
    "check:contract": "node scripts/check-server-contract.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.2",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  },
  "cloudflare": {
    "bindings": {
      "MCP_API_TOKEN": {
        "description": "Private bearer token protecting the MCP endpoint. Generate one with `openssl rand -hex 32`."
      }
    }
  },
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudflare-workers",
    "durable-objects",
    "sequential-thinking",
    "mcp-apps"
  ]
}
